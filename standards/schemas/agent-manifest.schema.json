{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-ai-configuration.invalid/schemas/agent-manifest.schema.json",
  "title": "Agent manifest",
  "type": "object",
  "required": ["kind", "schema_version", "id", "version", "name", "description", "compatibility", "permissions"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "agent" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "description": { "$ref": "common.schema.json#/$defs/text" },
    "compatibility": { "$ref": "common.schema.json#/$defs/compatibility" },
    "instructions_path": { "$ref": "common.schema.json#/$defs/path" },
    "skills": { "$ref": "common.schema.json#/$defs/idList" },
    "mcp_servers": { "$ref": "common.schema.json#/$defs/idList" },
    "technology_profiles": { "$ref": "common.schema.json#/$defs/idList" },
    "permissions": { "$ref": "common.schema.json#/$defs/permissions" },
    "function": { "enum": ["implementer", "reviewer", "validator", "advisor"] },
    "read_only": { "type": "boolean" },
    "independent_of": { "$ref": "common.schema.json#/$defs/idList" },
    "activation": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/text" } },
    "contracts": {
      "type": "object",
      "required": ["task", "result"],
      "additionalProperties": false,
      "properties": { "task": { "const": "task-contract" }, "result": { "const": "result" } }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "max_files_changed": { "type": "integer", "minimum": 0, "maximum": 100 } }
    }
  }
}
