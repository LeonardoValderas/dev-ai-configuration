{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-ai-configuration.invalid/schemas/compatibility-matrix.schema.json",
  "title": "Compatibility matrix",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "supported_schema_versions",
    "supported_standard_versions",
    "supported_tools"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "compatibility-matrix"
    },
    "supported_schema_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/schemaVersion"
      }
    },
    "supported_standard_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/schemaVersion"
      }
    },
    "supported_tools": {
      "$ref": "common.schema.json#/$defs/idList"
    },
    "adapter_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declarative",
            "cli_integration",
            "authenticated_enforcement",
            "verified_versions"
          ],
          "properties": {
            "declarative": {
              "enum": [
                "tested",
                "untested"
              ]
            },
            "cli_integration": {
              "enum": [
                "conditional",
                "untested"
              ]
            },
            "authenticated_enforcement": {
              "const": "unverified"
            },
            "verified_versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cli"
              ],
              "properties": {
                "cli": {
                  "type": "string",
                  "minLength": 1
                },
                "ide": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declarative",
            "cli_integration",
            "authenticated_enforcement",
            "verified_versions"
          ],
          "properties": {
            "declarative": {
              "enum": [
                "tested",
                "untested"
              ]
            },
            "cli_integration": {
              "enum": [
                "conditional",
                "untested"
              ]
            },
            "authenticated_enforcement": {
              "const": "unverified"
            },
            "verified_versions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cli"
              ],
              "properties": {
                "cli": {
                  "type": "string",
                  "minLength": 1
                },
                "ide": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
