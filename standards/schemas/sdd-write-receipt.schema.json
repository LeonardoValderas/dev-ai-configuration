{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-ai-configuration.invalid/schemas/sdd-write-receipt.schema.json",
  "title": "Receipt written by the SDD Artifact Writer inside the same transaction as the artifacts",
  "type": "object",
  "required": ["kind", "schema_version", "sequence", "project_id", "operation", "standard_commit", "plan_digest", "plan", "authorization", "previous_receipt_sha256", "files", "files_changed", "consumed_marker", "validation", "traceability", "verification", "receipt_digest"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "sdd-write-receipt" },
    "schema_version": { "const": "1.0" },
    "sequence": { "type": "integer", "minimum": 1 },
    "project_id": { "$ref": "common.schema.json#/$defs/id" },
    "operation": { "enum": ["create", "update"] },
    "standard_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "plan_digest": { "$ref": "#/$defs/sha256" },
    "plan": { "type": "object" },
    "authorization": {
      "type": "object",
      "required": ["nonce", "issued_at", "expires_at", "ttl_seconds", "approval"],
      "additionalProperties": false,
      "properties": {
        "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "issued_at": { "type": "string", "minLength": 20 },
        "expires_at": { "type": "string", "minLength": 20 },
        "ttl_seconds": { "const": 600 },
        "approval": {
          "type": "object",
          "required": ["channel", "approved_at"],
          "additionalProperties": false,
          "properties": {
            "channel": { "const": "trusted-tty" },
            "approved_at": { "type": "string", "minLength": 20 }
          }
        }
      }
    },
    "previous_receipt_sha256": { "type": "string", "pattern": "^([a-f0-9]{64}|none)$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "op", "before_sha256", "after_sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "common.schema.json#/$defs/path" },
          "op": { "enum": ["create", "update", "unchanged"] },
          "before_sha256": { "type": "string", "pattern": "^([a-f0-9]{64}|missing)$" },
          "after_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "files_changed": { "$ref": "common.schema.json#/$defs/pathList" },
    "consumed_marker": { "$ref": "common.schema.json#/$defs/path" },
    "validation": {
      "type": "object",
      "required": ["status", "artifacts"],
      "additionalProperties": false,
      "properties": {
        "status": { "const": "valid" },
        "artifacts": { "type": "array", "items": { "enum": ["constitution", "specify", "project"] } }
      }
    },
    "traceability": {
      "type": "object",
      "required": ["requirements", "acceptance_criteria", "requirement_to_criterion_links"],
      "additionalProperties": false,
      "properties": {
        "requirements": { "type": "integer", "minimum": 0 },
        "acceptance_criteria": { "type": "integer", "minimum": 0 },
        "requirement_to_criterion_links": { "type": "integer", "minimum": 0 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["mode", "scope", "status"],
      "additionalProperties": false,
      "properties": {
        "mode": { "const": "in-transaction-reread" },
        "scope": { "const": "every file written by the transaction, re-read from disk and hash-compared" },
        "status": { "const": "required-before-commit" }
      }
    },
    "receipt_digest": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
