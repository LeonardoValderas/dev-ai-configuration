{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-ai-configuration.invalid/schemas/sdd-specify.schema.json",
  "title": "SDD Specify artifact: requirements and acceptance criteria (persisted by the SDD Artifact Writer under .sdd/)",
  "type": "object",
  "required": ["kind", "schema_version", "project_id", "requirements", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "sdd-specify" },
    "schema_version": { "const": "1.0" },
    "project_id": { "$ref": "common.schema.json#/$defs/id" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "required": ["id", "statement", "acceptance_criteria", "open_questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "acceptance_criteria": { "$ref": "common.schema.json#/$defs/idList" },
        "open_questions": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["id", "requirement", "statement", "verification"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "requirement": { "$ref": "common.schema.json#/$defs/id" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "verification": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  }
}
