{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-ai-configuration.invalid/schemas/skill-manifest.schema.json",
  "title": "Skill manifest",
  "type": "object",
  "required": ["kind", "schema_version", "id", "version", "name", "description", "compatibility", "instructions_path"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "skill" },
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "version": { "$ref": "common.schema.json#/$defs/semver" },
    "name": { "$ref": "common.schema.json#/$defs/text" },
    "description": { "$ref": "common.schema.json#/$defs/text" },
    "compatibility": { "$ref": "common.schema.json#/$defs/compatibility" },
    "instructions_path": { "$ref": "common.schema.json#/$defs/path" },
    "requires_mcp": { "$ref": "common.schema.json#/$defs/idList" },
    "permissions": { "$ref": "common.schema.json#/$defs/permissions" },
    "activation": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/text" } },
    "auto_enable": { "const": false },
    "risk": { "enum": ["low", "medium", "high"] },
    "license": {
      "type": "object",
      "required": ["spdx", "evidence", "attribution", "notice_path"],
      "additionalProperties": false,
      "properties": {
        "spdx": { "$ref": "common.schema.json#/$defs/text" },
        "evidence": { "enum": ["license-file", "frontmatter-declaration", "upstream-verified"] },
        "attribution": { "$ref": "common.schema.json#/$defs/text" },
        "notice_path": { "$ref": "common.schema.json#/$defs/path" },
        "license_path": { "$ref": "common.schema.json#/$defs/path" },
        "provenance": { "$ref": "common.schema.json#/$defs/upstreamProvenance" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": { "$ref": "common.schema.json#/$defs/idList" },
        "external_services": { "$ref": "common.schema.json#/$defs/textList" },
        "runtime_tools": { "$ref": "common.schema.json#/$defs/textList" },
        "requires_credentials": { "type": "boolean" }
      }
    },
    "reference_paths": { "$ref": "common.schema.json#/$defs/pathList" },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claude-code": { "enum": ["untested", "unsupported"] },
        "codex": { "enum": ["untested", "unsupported"] },
        "cursor": { "enum": ["untested", "unsupported"] }
      }
    }
  }
}
