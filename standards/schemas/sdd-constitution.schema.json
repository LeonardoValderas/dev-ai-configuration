{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-ai-configuration.invalid/schemas/sdd-constitution.schema.json",
  "title": "SDD Constitution artifact (persisted by the SDD Artifact Writer under .sdd/)",
  "type": "object",
  "required": ["kind", "schema_version", "project_id", "principles", "constraints"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "sdd-constitution" },
    "schema_version": { "const": "1.0" },
    "project_id": { "$ref": "common.schema.json#/$defs/id" },
    "principles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/entry" }
    },
    "constraints": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "statement"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    }
  }
}
